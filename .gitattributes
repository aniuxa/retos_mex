# Normalizacion estable para trabajar entre Windows, RStudio, Quarto y GitHub.
* text=auto
/.gitattributes text eol=lf

# Codigo y documentos fuente: conservar LF en el repositorio y al checkout.
*.R       text eol=lf
*.Rmd     text eol=lf
*.qmd     text eol=lf
*.md      text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.css     text eol=lf
*.scss    text eol=lf
*.js      text eol=lf
*.html    text eol=lf

# Archivos binarios: nunca intentar convertir finales de linea.
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.otf     binary
*.woff    binary
*.woff2   binary
*.pdf     binary
